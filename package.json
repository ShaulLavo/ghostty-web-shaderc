{
  "name": "ghostty-web-shaderc",
  "version": "0.0.3",
  "description": "Runtime ShaderToy and Ghostty GLSL compiler for WebGPU and WebGL2",
  "keywords": [
    "compiler",
    "ghostty",
    "glsl",
    "shader",
    "shadertoy",
    "wasm",
    "webgl",
    "webgpu",
    "wgsl"
  ],
  "homepage": "https://github.com/ShaulLavo/ghostty-web-shaderc#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShaulLavo/ghostty-web-shaderc.git"
  },
  "bin": {
    "ghostty-web-shaderc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test/unit",
    "lint": "oxlint src test scripts examples",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepack": "bun run build",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun test ./test/unit && bun run build && bun run docs:check",
    "test:package": "bun scripts/package-test.ts",
    "test:browser": "bun scripts/browser-test.ts",
    "docs:check": "bun scripts/uniform-reference.ts --check",
    "showcase:dev": "bun run build && vite examples/showcase --host 127.0.0.1",
    "showcase:build": "bun run build && bun scripts/showcase-build.ts",
    "typecheck:showcase": "tsc --noEmit -p examples/showcase/tsconfig.json",
    "test:showcase": "bun scripts/showcase-test.ts"
  },
  "dependencies": {
    "naga-wasm": "30.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@webgpu/types": "0.1.74",
    "ghostty-webgpu": "0.1.2",
    "highlight.js": "11.12.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.0.2"
  },
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "bun@1.4.2"
}
