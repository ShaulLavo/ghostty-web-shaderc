{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM"],
    "strict": true, "noUncheckedIndexedAccess": true, "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "skipLibCheck": true,
    "noEmit": true, "types": ["bun", "@webgpu/types"]
  },
  "include": ["src", "test", "scripts"]
}
