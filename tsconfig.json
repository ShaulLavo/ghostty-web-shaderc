{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "ESNext.Disposable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun", "@webgpu/types"],
    "paths": {
      "@ghostty-webgpu/shaderc": ["./src/index.ts"],
      "@ghostty-webgpu/shaderc/runtime": ["./src/runtime.ts"]
    }
  },
  "include": ["src", "test", "scripts"]
}
